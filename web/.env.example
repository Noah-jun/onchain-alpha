# Live public data is the default. No key is required for prices, funding, or 5-minute scans.
# Set RESEARCH_ALLOW_DEMO=1 only if you explicitly want the labeled demo snapshot.
RESEARCH_ALLOW_DEMO=

# Optional. CoinGecko's public API works without it.
COINGECKO_API_KEY=

# NewsLiquid / 6551 token from https://6551.io/mcp
# Used as Authorization: Bearer for https://ai.6551.io
# OpenNews, OpenTwitter, and read-only OpenTrade. Never expose it to the browser.
NEWSLIQUID_API_TOKEN=

# CryptoPanic auth token: https://cryptopanic.com/developers/api/
NEWS_API_KEY=

# X API bearer token: https://developer.x.com
X_BEARER_TOKEN=

# Whale Alert key: https://whale-alert.io
WHALE_ALERT_API_KEY=

# OpenAI-compatible chat completions. Leave empty to show 未配置.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
