# Copy to web/.env. Leave providers on demo to run without keys.
# Secrets stay on the server. The settings page only shows whether a name is set.

# Market: demo | coingecko
# coingecko uses CoinGecko for BTC/ETH, Yahoo Finance for QQQ, SPX and crude, Binance for *USDT.
RESEARCH_MARKET_PROVIDER=demo
COINGECKO_API_KEY=

# News: demo | cryptopanic
NEWS_PROVIDER=demo
NEWS_API_KEY=

# X discussions: demo | x
# x requires a bearer token. Without it the app must stay on demo, not pretend to be connected.
SOCIAL_PROVIDER=demo
X_BEARER_TOKEN=

# Funding: demo | hyperliquid
FUNDING_PROVIDER=demo

# Whale transfers: demo | whalealert
ONCHAIN_PROVIDER=demo
WHALE_ALERT_API_KEY=

# 5-minute moves: demo | binance
VOLATILITY_PROVIDER=demo

# Optional OpenAI-compatible model. Without AI_API_KEY the in-app analyst is used.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
